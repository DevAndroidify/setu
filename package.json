{
  "name": "setu",
  "version": "0.1.0",
  "private": true,
  "description": "Migration platform for legacy Nepal government records",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start:api": "npm run build && node --env-file=.env dist/apps/api/main.js",
    "start:worker": "npm run build && node --env-file=.env dist/apps/worker/main.js",
    "test": "jest",
    "test:int": "jest --config test/integration/jest-int.config.js --runInBand",
    "test:e2e": "npm run build && jest --config test/e2e/jest-e2e.config.js --runInBand",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "npm run build && node --env-file=.env dist/prisma/seed.js",
    "postinstall": "prisma generate",
    "generate:data": "npm run build && node dist/tools/generate-legacy-data.js",
    "tamper-demo": "npm run build && node --env-file=.env dist/tools/tamper-demo.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,json,md,yml}": "prettier --write"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.7",
    "@prisma/client": "~6.19",
    "@remotemerge/nepali-date-converter": "^1.2.5",
    "argon2": "^0.45.1",
    "bullmq": "^6.4.0",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.3",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "^11.2.7",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prisma": "~6.19",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.1",
    "ts-jest": "^29.4.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.0"
  }
}
