# Copy to .env for local development. Never commit .env.
NODE_ENV=development
LOG_LEVEL=info
API_PORT=3000

# Used by docker-compose.yml to create the services, and by the app to reach them.
POSTGRES_USER=setu
POSTGRES_PASSWORD=setu_dev_password
POSTGRES_DB=setu
DATABASE_URL=postgresql://setu:setu_dev_password@localhost:5432/setu

REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=setu_minio
S3_SECRET_KEY=setu_minio_dev_secret
S3_BUCKET=setu-sources

# Signs access tokens. Use a long random value outside local development:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev_only_jwt_secret_change_me_0123456789
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
AUTH_RATE_LIMIT_PER_MINUTE=10

# The worker serves Prometheus metrics on this port (the API serves them on /metrics).
WORKER_METRICS_PORT=9464

# Password for the demo users created by `npm run db:seed` (one per role).
SEED_PASSWORD=Setu-demo-password-1
